    {
      "offerType": "APIManagement.CaaS.TraefikGateway",
      "params": [
        {
          "default": "39.0.9",
          "description": "traefik chart version (39.0.9 is Traefik v3.6.15)",
          "key": "chartVersion",
          "required": false,
          "type": "string"
        },
        {
          "default": 75,
          "description": "Idle timeout of the web entrypoint; must exceed the CloudFront keep-alive",
          "key": "entryPointIdleTimeoutSeconds",
          "required": false,
          "type": "integer"
        },
        {
          "description": "When set, a global ForwardAuth middleware to this URL authenticates every route",
          "key": "forwardAuthAddress",
          "required": false,
          "type": "string"
        },
        {
          "default": "",
          "description": "Comma-separated workloads whose own routes skip ForwardAuth (the auth server itself): a component id of this Live System, or <liveSystemId>/<componentId>. None by default. A path never exempts a route",
          "key": "forwardAuthExemptComponentIds",
          "required": false,
          "type": "string"
        },
        {
          "default": true,
          "key": "forwardAuthForwardBody",
          "required": false,
          "type": "boolean"
        },
        {
          "default": 1048576,
          "key": "forwardAuthMaxBodySize",
          "required": false,
          "type": "integer"
        },
        {
          "default": "authorization,cookie,x-clientid,x-clientsecret,origin",
          "key": "forwardAuthRequestHeaders",
          "required": false,
          "type": "string"
        },
        {
          "default": "x-jwt",
          "key": "forwardAuthResponseHeaders",
          "required": false,
          "type": "string"
        },
        {
          "description": "Default host of every route, e.g. api.fractal.cloud",
          "key": "host",
          "required": false,
          "type": "string"
        },
        {
          "default": true,
          "description": "EKS: internal NLB (true) or internet-facing (false)",
          "key": "internalLoadBalancer",
          "required": false,
          "type": "boolean"
        },
        {
          "description": "Comma-separated CIDRs allowed to reach the load balancer (spec.loadBalancerSourceRanges)",
          "key": "loadBalancerSourceRanges",
          "required": false,
          "type": "string"
        },
        {
          "default": "traefik",
          "key": "namespace",
          "required": false,
          "type": "string"
        },
        {
          "description": "Expose web (80) and serve the routes on it. Default true without TLS (unchanged gateways), false with TLS",
          "key": "plainHttp",
          "required": false,
          "type": "boolean"
        },
        {
          "default": 2,
          "key": "replicas",
          "required": false,
          "type": "integer"
        },
        {
          "description": "EKS: ACM certificate for an NLB TLS listener on 443 forwarding to the web entrypoint. Not for a gateway behind CloudFront: an NLB with a TLS listener cannot be a CloudFront VPC origin. Excludes tlsSecretName / tlsClusterIssuer",
          "key": "tlsCertificateArn",
          "required": false,
          "type": "string"
        },
        {
          "description": "Traefik TLS: cert-manager ClusterIssuer (e.g. the Security.CaaS.CertManager offer's clusterIssuerName) the gateway requests its own Certificate for tlsHosts from",
          "key": "tlsClusterIssuer",
          "required": false,
          "type": "string"
        },
        {
          "description": "Comma-separated hosts the certificate covers (exact or *.one-label wildcards); default host. Must cover every viewer host CloudFront forwards: every route host is checked against it",
          "key": "tlsHosts",
          "required": false,
          "type": "string"
        },
        {
          "description": "Traefik TLS: kubernetes.io/tls Secret in the gateway namespace served on websecure (TCP 443 through the NLB). Default traefik-tls when tlsClusterIssuer is set; unset with no issuer = no TLS",
          "key": "tlsSecretName",
          "required": false,
          "type": "string"
        },
        {
          "description": "Chart values deep-merged over the agent's, for operators",
          "key": "values",
          "required": false,
          "type": "object"
        }
      ],
      "provider": "CaaS",
      "serviceTypes": [
        "APIManagement.CaaS.Traefik"
