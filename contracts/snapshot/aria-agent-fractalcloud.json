    {
      "aliasOfOfferType": null,
      "canAccessSecrets": true,
      "contractSchemaVersion": "2.0",
      "offerType": "BigData.PaaS.FractalSparkJob",
      "parameterRules": [
        {
          "fix": "Set artifactUri to the URL of the Python wheel the job runs, or jarUri to the jar and mainClass to its main class.",
          "id": "job-artifact",
          "keys": [
            "jarUri",
            "artifactUri"
          ],
          "kind": "anyOf",
          "message": "The job does not say what to run."
        }
      ],
      "params": [
        {
          "description": "the kind of artifact in artifactUri; when unset, a Python wheel",
          "key": "artifactType",
          "type": "string",
          "values": [
            "python_wheel"
          ],
          "valuesLevel": "warn"
        },
        {
          "description": "the URL of the Python wheel the job runs, wrapped into an image by the agent",
          "example": "https://artifacts.example/etl-1.0-py3-none-any.whl#sha256=<digest>",
          "key": "artifactUri",
          "type": "string"
        },
        {
          "description": "the short names of the environment secrets this component may read",
          "key": "environmentSecretShortNames",
          "type": "array"
        },
        {
          "default": "apache/spark:3.5.0",
          "key": "image",
          "type": "string"
        },
        {
          "description": "the jar the job runs, when it does not run a Python wheel from artifactUri",
          "example": "local:///opt/spark/examples/jars/spark-examples_2.12-3.5.0.jar",
          "key": "jarUri",
          "type": "string"
        },
        {
          "default": "",
          "description": "the main class of the jar in jarUri",
          "example": "org.apache.spark.examples.SparkPi",
          "key": "mainClass",
          "type": "string"
        },
        {
          "derived": {
            "note": "the component id, with - read as _"
          },
          "description": "the Python package the wheel installs",
          "key": "packageName",
          "type": "string"
        },
        {
          "default": "",
          "key": "schedule",
          "type": "string"
        },
        {
          "derived": {
            "note": "the agent's pinned Spark base image"
          },
          "description": "the Spark image the wheel is installed on",
          "key": "sparkBaseImage",
          "type": "string"
        }
      ],
      "provider": "FractalCloud",
      "providerResources": [
        {
          "type": "sparkoperator.k8s.io/SparkApplication"
        },
        {
          "type": "sparkoperator.k8s.io/ScheduledSparkApplication"
        }
      ],
      "runtimeChecks": [],
      "serviceTypes": [
        "BigData.PaaS.SparkPlatformJob"
      ]
    },
