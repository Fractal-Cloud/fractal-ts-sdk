          "description": "the Secret in the server's namespace holding accessKey and secretKey of the MinIO user the server vends credentials as",
          "example": "uc-lake-user",
          "key": "storageCredentialsSecret",
          "type": "string"
        },
        {
          "description": "the S3 endpoint of the MinIO the cataloged tables are stored in, whose STS vends their credentials",
          "example": "http://minio.lake.svc.cluster.local",
          "key": "storageEndpoint",
          "type": "string"
        },
        {
          "default": "us-east-1",
          "description": "the region of that endpoint",
          "key": "storageRegion",
          "type": "string"
        },
        {
          "description": "what happens to the service's data volumes when it is deleted: Retain keeps them until they are reclaimed, Delete deletes their data; unset follows the environment (Retain in production, Delete otherwise)",
          "example": "Retain",
          "key": "volumeRetention",
          "type": "string",
          "values": [
            "Retain",
            "Delete"
          ],
          "valuesCaseInsensitive": true
        }
      ],
      "provider": "FractalCloud",
      "providerResources": [
        {
          "discriminator": {
            "name": "app.kubernetes.io/name",
            "value": "unitycatalog"
          },
          "type": "apps/Deployment"
        }
      ],
      "runtimeChecks": [
        {
          "field": "storageEndpoint",
          "fix": "set all three, or none",
          "id": "storage-together",
          "message": "storageEndpoint, storageCredentialsSecret and storageBuckets go together",
          "reason": "NOT_EXPRESSIBLE"
        }
      ],
      "serviceTypes": [
        "BigData.PaaS.UnityCatalog"
