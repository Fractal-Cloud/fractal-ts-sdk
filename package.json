{
  "name": "@fractal_cloud/sdk",
  "version": "2.3.5",
  "description": "Typescript Fractal Cloud SDK",
  "license": "AGPL-3.0-or-later",
  "author": "Fractal Cloud",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./model": {
      "import": {
        "types": "./dist/model/index.d.mts",
        "default": "./dist/model/index.mjs"
      },
      "require": {
        "types": "./dist/model/index.d.cts",
        "default": "./dist/model/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Fractal-Cloud/fractal-ts-sdk"
  },
  "scripts": {
    "build": "tsdown",
    "build:docs": "typedoc --entryPointStrategy Expand --exclude \"**/*+(.test|.e2e).ts\" src",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.guides.json",
    "test": "npm run typecheck && vitest run --coverage",
    "test:watch": "vitest",
    "lint": "gts lint",
    "lint:fix": "gts fix",
    "posttest": "npm run lint"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/superagent": "^8.1.11",
    "@vitest/coverage-v8": "^5.0.3",
    "gts": "^7.0.0",
    "tsdown": "^0.23.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "superagent": "^10.4.1"
  }
}
